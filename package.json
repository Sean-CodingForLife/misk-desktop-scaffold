{
  "name": "misk-desktop-scaffold",
  "version": "2.0.0",
  "description": "Misk Desktop - a general-purpose Electron desktop shell scaffold.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Misk Desktop contributors"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "screenshot": "npm run build && playwright test tests/e2e/screenshot.spec.ts",
    "package": "npm run build && electron-builder --config electron-builder.config.cjs",
    "package:win": "npm run build && electron-builder --config electron-builder.config.cjs --win",
    "package:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac",
    "package:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux",
    "gen:module": "node scripts/generate.mjs module",
    "gen:view": "node scripts/generate.mjs view",
    "gen:panel": "node scripts/generate.mjs panel",
    "gen:settings": "node scripts/generate.mjs settings",
    "rename-app": "node scripts/rename-app.mjs",
    "eject-demo": "node scripts/eject-demo.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-log": "^5.4.4",
    "i18next": "^26.5.3",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
